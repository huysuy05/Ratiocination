# Ratiocination configuration (docs/SPEC.md §3).
# Copy to .env in the repository root and uncomment what you need. Real environment variables win
# over this file. Never commit .env: it holds secrets (OAuth client secrets, SMTP password, API keys).
# Deploying on Fly.io: fly.toml holds the non-secret settings and docs/DEPLOY.md lists the secrets to
# set with `fly secrets set`. The container image ignores .env files (RADAR_ENV_FILE is empty there).

# ---- Storage --------------------------------------------------------------------------------
# Data root: radar.db, uploads/, models/ (embedding model cache), logs/. Default: <repo>/data
# RADAR_DATA_DIR=./data
# SQLAlchemy URL. Default: sqlite:///<RADAR_DATA_DIR>/radar.db
# RADAR_DATABASE_URL=sqlite:////absolute/path/to/radar.db

# ---- Accounts -------------------------------------------------------------------------------
# accounts = people sign in (Google, GitHub, email + password); local = one user, no sign-in,
# loopback only.
# RADAR_AUTH=accounts
# The origin people open in their browser. Builds OAuth redirect URIs and email links; an https URL
# makes the session cookie Secure and turns on HSTS. Must be https on a public server (the server
# refuses to start otherwise). With the Vite dev server use http://localhost:5173.
# RADAR_PUBLIC_URL=http://localhost:8000
# Email + password accounts (1/0).
# RADAR_PASSWORD_LOGIN=1
# Google sign-in: create an OAuth client (type "Web application") with the redirect URI
#   <RADAR_PUBLIC_URL>/api/auth/oauth/google/callback
# RADAR_GOOGLE_CLIENT_ID=
# RADAR_GOOGLE_CLIENT_SECRET=
# GitHub sign-in: create an OAuth app with the callback URL
#   <RADAR_PUBLIC_URL>/api/auth/oauth/github/callback
# RADAR_GITHUB_CLIENT_ID=
# RADAR_GITHUB_CLIENT_SECRET=
# Who may sign up: comma list of addresses or @domains. Unset = anyone who reaches the server.
# RADAR_ALLOWED_EMAILS=
# Administrators (comma list). Required for a non-loopback bind; when unset the first account is admin.
# RADAR_ADMIN_EMAILS=
# Session lifetime in days (sliding).
# RADAR_SESSION_DAYS=30
# Password accounts must confirm their email before they get a session (and before admin rights).
# Unset = on for a public server (non-loopback bind, TLS proxy, or a non-localhost RADAR_PUBLIC_URL),
# off on a loopback-only dev server. A public server without SMTP closes password sign-up.
# RADAR_REQUIRE_EMAIL_VERIFICATION=
# Outgoing mail for verification and password-reset links. Without it, an operator can print one-time
# links: `python -m radar.cli invite-link --email <address>` (creates the account; choosing a password
# on the link confirms the address, e.g. for the first admin) or `... reset-link --email <address>`.
# RADAR_SMTP_HOST=
# RADAR_SMTP_PORT=587
# RADAR_SMTP_USERNAME=
# RADAR_SMTP_PASSWORD=
# RADAR_SMTP_FROM=
# RADAR_SMTP_SECURITY=starttls

# ---- Server / network exposure ----------------------------------------------------------------
# Bind address and port (uvicorn runs ONE worker). Keep the loopback default unless you know why.
# A public server (non-loopback bind, RADAR_BEHIND_TLS_PROXY=1, or a non-localhost RADAR_PUBLIC_URL)
# requires RADAR_AUTH=accounts, RADAR_ADMIN_EMAILS, TLS and an https RADAR_PUBLIC_URL.
# RADAR_HOST=127.0.0.1
# RADAR_PORT=8000
# TLS for a non-loopback bind: either a certificate + key ...
# RADAR_TLS_CERT=/path/to/cert.pem
# RADAR_TLS_KEY=/path/to/key.pem
# ... or a TLS-terminating reverse proxy in front of the app.
# RADAR_BEHIND_TLS_PROXY=0
# Extra Host header values to accept (comma list), e.g. a LAN name used through a proxy.
# RADAR_ALLOWED_HOSTS=
# Extra Origin values allowed on non-GET /api requests (comma list), e.g. a Vite dev server on a
# non-default port: http://localhost:5174. The own origin, RADAR_PUBLIC_URL and
# http://localhost:5173 are always allowed.
# RADAR_DEV_ORIGINS=
# Header your TLS proxy sets to the real client IP (Fly.io: Fly-Client-IP). It then replaces the
# proxy's address as the client IP (per-IP sign-in throttle, access log). Set it only when every
# request goes through that proxy, which must overwrite any value a client sends.
# RADAR_CLIENT_IP_HEADER=

# ---- Privacy / egress ---------------------------------------------------------------------------
# 1 blocks all outbound HTTP and model downloads.
# RADAR_OFFLINE=0
# Polite-pool contact email for OpenAlex. Sent ONLY when set (it identifies you to OpenAlex).
# RADAR_CONTACT_EMAIL=

# ---- AI summaries (optional) --------------------------------------------------------------------
# Enables "Summarize with Claude" on the dashboard. Only public titles and abstracts are sent.
# ANTHROPIC_API_KEY=
# RADAR_SUMMARY_MODEL=claude-opus-5-5
# Requests per user per UTC day, and for all users together (at least 1; bounds the daily spend).
# RADAR_SUMMARIES_PER_DAY=5
# RADAR_SUMMARIES_GLOBAL_PER_DAY=50

# ---- Embeddings ---------------------------------------------------------------------------------
# Embedding model: fastembed/BAAI/bge-small-en-v1.5 (default, 67 MB), fastembed/BAAI/bge-base-en-v1.5
# (opt-in, 219 MB, ~3.5x the CPU per paper; not clearly better in the 2026-10-13 comparison, docs/SPEC.md
# §9) or local/hashing-v1. A fastembed model is downloaded only by an explicit action
# (`python -m radar.cli download-model` or Settings); until then another downloaded fastembed model,
# else local/hashing-v1, is used. Switching re-embeds each project's candidates at its next deck.
# RADAR_EMBEDDER=fastembed/BAAI/bge-small-en-v1.5

# ---- Daily scheduler ----------------------------------------------------------------------------
# Initial scheduler state (the setting saved in the app wins once changed there).
# RADAR_SCHEDULER=0
# RADAR_DAILY_CRON=30 0 * * *
# RADAR_TIMEZONE=America/New_York

# ---- Sources and budgets --------------------------------------------------------------------------
# OpenAlex API key (sent as the api_key query parameter). Without a key the budget is $0.10/day.
# OPENALEX_API_KEY=
# OpenAlex daily budget in USD. Default: 1.0 with a key, 0.1 without.
# RADAR_OPENALEX_DAILY_BUDGET_USD=
# Stop a metered connector at this fraction of its daily budget.
# RADAR_BUDGET_STOP_FRACTION=0.8
# Semantic Scholar API key (header x-api-key). Optional: without it S2 is used best-effort.
# S2_API_KEY=
# Minutes to pause Semantic Scholar after a keyless HTTP 429, and the arXiv API after a 429.
# RADAR_S2_BREAKER_MINUTES=15
# RADAR_ARXIV_BREAKER_MINUTES=10

# ---- Limits -------------------------------------------------------------------------------------------
# Automatic citation loads per day (all users) and manual ones per user per day.
# RADAR_MAX_EXPANSIONS_PER_DAY=10
# RADAR_EXPANSIONS_PER_USER_PER_DAY=30
# Breakthrough analyses per user per day.
# RADAR_BREAKTHROUGHS_PER_DAY=5
# Uploads: per file (MB) and per user in total (MB); projects per user. Other request bodies are
# limited to 64 KB (not configurable).
# RADAR_MAX_UPLOAD_MB=50
# RADAR_USER_STORAGE_MB=500
# RADAR_MAX_PROJECTS=50

# ---- Development / tests only ----------------------------------------------------------------------
# Transaction strict mode (raises on writes in read sessions and on network calls inside a write
# transaction). The test suite turns it on.
# RADAR_STRICT_TX=0
# Run submitted jobs synchronously right after dispatch (tests).
# RADAR_JOBS_INLINE=0
